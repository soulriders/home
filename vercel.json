{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/homepage_static_draft.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/ir.html",
      "destination": "/?page=ir",
      "permanent": true
    },
    {
      "source": "/visitor_vc.html",
      "destination": "/?page=ir",
      "permanent": true
    },
    {
      "source": "/visitor_individual.html",
      "destination": "/?page=ir",
      "permanent": true
    },
    {
      "source": "/ip.html",
      "destination": "/?page=ip",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
